# Copia este archivo como .env.local y pega tu API key de YouTube Data API v3.
# (.env.local no se sube a GitHub)
REACT_APP_YOUTUBE_API_KEY=

# Minutos que el navegador guarda las playlists antes de volver a consultar YouTube.
REACT_APP_PLAYLIST_CACHE_MINUTES=15

# Avisos (notificaciones). Se generan una vez; en Netlify van como variables de entorno.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
